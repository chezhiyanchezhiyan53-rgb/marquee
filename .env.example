# ============================================
# CineBook Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local MongoDB (standalone — transactions may NOT work):
# MONGODB_URI=mongodb://127.0.0.1:27017/cinebook
#
# Local MongoDB replica set (transactions WORK):
# MONGODB_URI=mongodb://127.0.0.1:27017/cinebook?replicaSet=rs0
#
# MongoDB Atlas (transactions WORK — recommended):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cinebook?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:5000

# Seed admin account (used only by seed script — never hardcode in production)
SEED_ADMIN_EMAIL=admin@cinebook.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=CineBook Admin
