{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/movie",
      "destination": "/frontend/pages/movie.html"
    },
    {
      "source": "/seats",
      "destination": "/frontend/pages/seats.html"
    },
    {
      "source": "/confirmation",
      "destination": "/frontend/pages/confirmation.html"
    },
    {
      "source": "/bookings",
      "destination": "/frontend/pages/bookings.html"
    },
    {
      "source": "/admin",
      "destination": "/frontend/pages/admin.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/pages/login.html"
    },
    {
      "source": "/register",
      "destination": "/frontend/pages/register.html"
    },
    {
      "source": "/css/(.*)",
      "destination": "/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/frontend/js/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/assets/$1"
    },
    {
      "source": "/pages/(.*)",
      "destination": "/frontend/pages/$1"
    }
  ]
}
